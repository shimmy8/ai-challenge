# Локальные реквизиты CalDAV для личного Яндекс Календаря.
# Скопируйте файл в .env-mcp и замените значения.
YANDEX_CALDAV_USERNAME="ваш логин Яндекса"
YANDEX_CALDAV_PASSWORD="пароль приложения типа Календарь"
# Необязательно: нужно только если календарей несколько.
YANDEX_CALDAV_CALENDAR="Личный"
# Необязательно: используется только для локальных mock-тестов.
# YANDEX_CALDAV_ENDPOINT="https://caldav.yandex.ru"

# Telegram для фоновых сводок. Создайте бота через BotFather и укажите
# заранее выбранный chat ID; эти значения не передаются MCP-инструментам.
TELEGRAM_BOT_TOKEN="ваш токен Telegram-бота"
TELEGRAM_CHAT_ID="ваш chat ID"
